# Supabase configuration.
# Copy this file to `.env` and fill in the values from your Supabase project:
#   Supabase Dashboard -> Project Settings -> Data API / API Keys
#
# These are read at build time in app.config.ts and exposed to the app through
# Constants.expoConfig.extra (see lib/supabase.ts). Never commit the real .env.
#
# The anon/publishable key is a CLIENT key and is safe to ship in the app bundle.
# NEVER put the service_role (secret) key here — it must never reach the client.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# --- Crash reporting (Sentry) ---
# DSN is a publishable client key (safe to ship). Empty → crash reporting is disabled.
SENTRY_DSN=
# Only needed at BUILD time to upload source maps (never shipped in the app bundle):
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- Product analytics (PostHog) ---
# Project API key is publishable (safe to ship). Empty → analytics is a no-op.
POSTHOG_KEY=
# Ingestion host. Use the region that matches your PostHog project (eu or us).
POSTHOG_HOST=https://eu.i.posthog.com
