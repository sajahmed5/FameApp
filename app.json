{
  "expo": {
    "name": "Fame",
    "slug": "fame",
    "owner": "sajahmed5",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fame",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "icon": "./assets/expo.icon",
      "supportsTablet": true,
      "bundleIdentifier": "com.fameapp.fame",
      "associatedDomains": ["applinks:lovefame.co.uk", "applinks:www.lovefame.co.uk"]
    },
    "android": {
      "package": "com.fameapp.fame",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "lovefame.co.uk", "pathPrefix": "/post" },
            { "scheme": "https", "host": "www.lovefame.co.uk", "pathPrefix": "/post" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "lovefame.co.uk", "pathPrefix": "/u" },
            { "scheme": "https", "host": "www.lovefame.co.uk", "pathPrefix": "/u" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-video",
      "expo-localization",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Fame uses your location only when you choose to add where a post was taken. It's stored as a coarse area, never your exact position."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "Fame uses the camera so you can capture photos and videos to post.",
          "microphonePermission": "Fame uses the microphone to record audio for your videos.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Fame needs access to your photos so you can pick existing media to post."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#C85A28"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#C85A28",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "ce6bcabb-42f6-4ae2-90d7-5ca670af9229"
      }
    }
  }
}
