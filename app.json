{
  "expo": {
    "name": "Phixr",
    "slug": "phixr",
    "owner": "sajahmed5",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "phixr",
    "userInterfaceStyle": "automatic",
    "updates": {
      "url": "https://u.expo.dev/ce6bcabb-42f6-4ae2-90d7-5ca670af9229"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.phixr.app",
      "associatedDomains": ["applinks:joinphixr.com", "applinks:www.joinphixr.com"]
    },
    "android": {
      "package": "com.phixr.app",
      "adaptiveIcon": {
        "backgroundColor": "#FF7A18",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "joinphixr.com", "pathPrefix": "/post" },
            { "scheme": "https", "host": "www.joinphixr.com", "pathPrefix": "/post" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "joinphixr.com", "pathPrefix": "/u" },
            { "scheme": "https", "host": "www.joinphixr.com", "pathPrefix": "/u" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-video",
      "expo-localization",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Phixr uses your location only when you choose to add where a post was taken. It's stored as a coarse area, never your exact position."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "Phixr uses the camera so you can capture photos and videos to post.",
          "microphonePermission": "Phixr uses the microphone to record audio for your videos.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Phixr needs access to your photos so you can pick existing media to post."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FF7A18"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FF7A18",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "ce6bcabb-42f6-4ae2-90d7-5ca670af9229"
      }
    }
  }
}
